# Venti — example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit your real `.env`
# (it is gitignored). Values below are placeholders only.

# --- LLM / Anthropic ---
# API key for the Anthropic SDK backend. Only needed when LLM_BACKEND=api.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Which inference transport to use: "cli" (shell out to the `claude` binary)
# or "api" (Anthropic SDK, requires ANTHROPIC_API_KEY).
LLM_BACKEND=cli
# Model id used for emotion inference and query generation.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Spotify ---
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- App ---
# Secret used to sign sessions/cookies once a web backend exists.
APP_SECRET=change-me-to-a-long-random-string

# --- Database (T5.10 event store) ---
# SQLite file for the analytics event store (event metadata only — never
# vent text). Optional locally (defaults to data/venti.db, gitignored).
# On Railway, set this to a file on a mounted Volume, e.g. /data/venti.db —
# without a volume the database is wiped on every redeploy.
DATABASE_PATH=data/venti.db
# Enables GET /api/admin/export (owner-only JSONL dump of the events table).
# Leave unset to keep the route hidden (404). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_EXPORT_TOKEN=change-me-to-a-long-random-string
